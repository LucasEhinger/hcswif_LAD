# HTCondor submit description for lad_replay batch jobs on MIT SUBMIT.
# Equivalent of a swif2 workflow JSON generated by:
#   ./hcswif.py --mode replay --spectrometer LAD_COIN --run file <runlist> ...
#
# Run list format: 5 columns, one job per line -- same file produced by
# make_lad_runlist.sh:
#   run  seg_end  seg_start  config_num  zero
#
# Before first use, and again any time lad_replay has changed:
#   ./make_tar_submit.sh
#
# Submit with the default run list below:
#   condor_submit replay_submit.sub
# Or point at a different run list / replay script from the command line:
#   condor_submit replay_submit.sub runlist=run-lists/photon_flash_all_C_updated.dat

runlist        = run-lists/runlist.dat
replay_script  = SCRIPTS/LAD_COIN/PRODUCTION/replay_production_lad_spec.C
events         = -1

executable     = run_lad_replay_submit.sh
arguments      = $(replay_script) $(run) $(events) $(config_num) $(seg_end) $(seg_start)

should_transfer_files = NO
output         = logs/$(run)_$(seg_start)-$(seg_end).out
error          = logs/$(run)_$(seg_start)-$(seg_end).err
log            = logs/$(run)_$(seg_start)-$(seg_end).log

request_cpus   = 1
request_memory = 4GB
request_disk   = 20GB

queue run,seg_end,seg_start,config_num,zero from $(runlist)
